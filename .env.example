# Required. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Any model with the ":free" suffix from https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Defaults shown below.
# PORT=8787
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# APP_NAME=saldo-test chat
# APP_URL=http://localhost:8787

# Optional watchdogs (ms). No total-time cap on purpose: only silence is
# suspicious — free reasoning models routinely "think" without emitting.
# FIRST_BYTE_TIMEOUT_MS=60000  # waiting for response headers
# IDLE_TIMEOUT_MS=90000        # silence in the middle of a stream
